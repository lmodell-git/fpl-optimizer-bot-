# Copy to .env for local runs (never commit .env). In GitHub these are repo secrets.

# Gmail app password — same one the momentum-check / risk-scan jobs use.
# Make at https://myaccount.google.com/apppasswords  (needs 2-Step Verification on).
GMAIL_APP_PASSWORD=

# Anthropic API key for the Claude sanity-check pass. Optional: without it the
# pipeline still runs and emails the raw solver output.
ANTHROPIC_API_KEY=

# Optional overrides
# FPL_CLAUDE_MODEL=claude-opus-5
# FPL_STATE=./state.json
# DRY_RUN=1
# FORCE_NOTIFY=1
# NO_CLAUDE=1
